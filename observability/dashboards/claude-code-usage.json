{
  "title": "Claude Code usage",
  "uid": "cplat-claude-code-usage",
  "tags": [
    "cplat",
    "claude-code"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Tokens per run",
      "type": "bargauge",
      "description": "Tokens of every type, by cplat run id, over the selected time range",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (cplat_run_id) (increase(claude_code_token_usage_tokens_total[$__range]))",
          "legendFormat": "{{cplat_run_id}}",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "title": "Estimated cost per run (USD)",
      "type": "bargauge",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (cplat_run_id) (increase(claude_code_cost_usage_USD_total[$__range]))",
          "legendFormat": "{{cplat_run_id}}",
          "range": true
        }
      ]
    },
    {
