{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": {"baseRef": "head"},
  "extraKnownMarketplaces": {
    "sdlc-foundry": {
      "source": {
        "source": "github",
        "repo": "ika100/sdlc-foundry",
        "ref": "main"
      }
    }
  },
  "enabledPlugins": {
    "system@sdlc-foundry": true,
    "component@sdlc-foundry": true,
    "api@sdlc-foundry": true,
    "resource@sdlc-foundry": true,
    "instance@sdlc-foundry": true,
    "issue@sdlc-foundry": true,
    "platform@sdlc-foundry": true,
    "svc@sdlc-foundry": true,
    "shared@sdlc-foundry": true
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(cplat *)",
      "Bash(git commit *)",
      "Bash(git pull --ff-only)",
      "Bash(git pull --ff-only *)",
      "Bash(git pull -q --ff-only)",
      "Bash(git pull -q --ff-only *)",
      "Bash(git branch -D worktree-agent-*)",
      "Bash(git branch -D -q worktree-agent-*)",
      "Bash(gh pr create *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr comment *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh run watch *)",
      "Bash(gh workflow run *)",
      "Bash(gh issue comment *)",
      "Bash(gh api repos/*/actions/jobs/*/logs*)",
      "Bash(gh api repos/*/commits/*/check-runs*)",
      "Bash(docker build *)",
      "Bash(docker run --rm *)",
      "Bash(docker image inspect *)",
      "Bash(docker rmi *)",
      "Bash(docker rm *)",

      "Bash(devbox run *)",
      "Bash(devbox install)",
      "Bash(devbox shell)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git add *)",
      "Read(~/.claude/plugins/**)",
      "Bash(git checkout -b *)",
      "Bash(git checkout main)",
      "Bash(git fetch *)",
      "Bash(git merge --ff-only *)",
      "Bash(git push -u origin promote/*)",
      "Bash(git push -u origin compose/*)",
      "Bash(git push -u origin feature/*)",
      "Bash(git push -u origin component/*)",
      "Bash(git push -u origin resource/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh repo view *)",
      "Bash(gh api repos/*)",
      "Bash(gh repo clone *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(jq *)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push origin main)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git rebase *)",
      "Bash(gh pr merge *)",
      "Bash(kubectl *)"
    ]
  }
}
